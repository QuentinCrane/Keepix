    <string name="permission_title">Photo library access required</string>
    <string name="permission_intro">Keepix organizes your full photo library, so it needs access to photos and videos. Scanning stays on this device and media files are never uploaded.</string>
    <string name="permission_platform_notice">On Android 14 and later, choosing “Select photos and videos” only allows Keepix to clean the selected items. Choose all photos and videos in the system dialog for full-library cleaning.</string>
    <string name="permission_partial_notice">The timeline and cleaning flow only show photos and videos Android allows Keepix to access. To clean the full library, grant access again and choose all photos and videos.</string>
