    <string name="onboarding_home_title">Keepix</string>
    <string name="onboarding_home_subtitle">Clean your library like browsing a feed</string>
    <string name="onboarding_home_body">Photos and videos have separate paths: swipe photo cards, or move through videos in a short-video flow. Review the rules, then grant photo access.</string>
    <string name="onboarding_home_bullet_1">Photos: swipe left or right to keep, up or down to favorite or delete</string>
    <string name="onboarding_home_bullet_2">Videos: swipe up or down to switch, left or right to scrub</string>
    <string name="onboarding_home_bullet_3">Items marked for deletion go to a review area first</string>
    <string name="onboarding_photo_title">Photo cleaning gestures</string>
    <string name="onboarding_photo_subtitle">Swipe, confirm, then decide</string>
    <string name="onboarding_photo_body">Tap a photo to inspect it. Swiping toward an edge shows a clear keep, favorite, or delete cue.</string>
    <string name="onboarding_photo_bullet_1">Swipe left or right: keep</string>
    <string name="onboarding_photo_bullet_2">Swipe up or down: favorite or delete based on settings</string>
    <string name="onboarding_photo_bullet_3">Exclude folders you do not want to clean in Settings</string>
    <string name="onboarding_video_title">Video cleaning</string>
    <string name="onboarding_video_subtitle">Short-video browsing without forcing one ratio</string>
    <string name="onboarding_video_body">The video home lets you choose sorting, folders, and display ratio before entering the immersive cleaning flow.</string>
    <string name="onboarding_video_bullet_1">Swipe up or down to switch videos</string>
    <string name="onboarding_video_bullet_2">Hold for 2x speed, release to restore</string>
    <string name="onboarding_video_bullet_3">Choose immersive crop, fit screen, or fill width</string>
    <string name="onboarding_privacy_title">Privacy and safety</string>
    <string name="onboarding_privacy_subtitle">Clean locally, delete carefully</string>
    <string name="onboarding_privacy_body">Keepix uses local MediaStore and Room, and keeps cleaning and stats on this device by default.</string>
    <string name="onboarding_privacy_bullet_1">Your cleaning profile is based on real activity stored on this device</string>
    <string name="onboarding_privacy_bullet_2">Excluded folders affect both photos and videos</string>
    <string name="onboarding_privacy_bullet_3">Deletion goes to review by default instead of immediate permanent removal</string>
