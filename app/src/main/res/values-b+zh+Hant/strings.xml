    <string name="onboarding_home_title">看了麼</string>
    <string name="onboarding_home_subtitle">像瀏覽內容一樣整理相簿</string>
    <string name="onboarding_home_body">照片和影片是並列入口：照片用卡片滑動整理，影片用短影音流程上下切換。先看一遍規則，再授權相簿。</string>
    <string name="onboarding_home_bullet_1">照片：左右保留，上下收藏或待刪</string>
    <string name="onboarding_home_bullet_2">影片：上下切換，左右快進快退</string>
    <string name="onboarding_home_bullet_3">所有待刪內容先進入確認區，避免誤刪</string>
    <string name="onboarding_photo_title">照片整理手勢</string>
    <string name="onboarding_photo_subtitle">輕滑、確認、再處理</string>
    <string name="onboarding_photo_body">點選照片可以放大查看；滑動到邊緣會出現明顯的保留、收藏、待刪提示。</string>
    <string name="onboarding_photo_bullet_1">左右滑：保留</string>
    <string name="onboarding_photo_bullet_2">上下滑：依設定執行收藏或待刪</string>
    <string name="onboarding_photo_bullet_3">可在設定中排除不想整理的資料夾</string>
    <string name="onboarding_video_title">影片整理方式</string>
    <string name="onboarding_video_subtitle">短影音式瀏覽，不強制一種比例</string>
    <string name="onboarding_video_body">影片有獨立首頁，可先切換排序、資料夾、顯示比例，再進入沉浸式整理流程。</string>
    <string name="onboarding_video_bullet_1">上下滑切換影片</string>
    <string name="onboarding_video_bullet_2">長按 2 倍速，放開恢復</string>
    <string name="onboarding_video_bullet_3">顯示比例可選沉浸裁切、完整比例或鋪滿螢幕寬度</string>
    <string name="onboarding_privacy_title">隱私與安全</string>
    <string name="onboarding_privacy_subtitle">本機整理，謹慎刪除</string>
    <string name="onboarding_privacy_body">看了麼以本機 MediaStore 和 Room 為主，預設在本機完成整理與統計。</string>
    <string name="onboarding_privacy_bullet_1">整理性格根據本機真實整理記錄產生</string>
    <string name="onboarding_privacy_bullet_2">排除資料夾會同時影響照片和影片</string>
    <string name="onboarding_privacy_bullet_3">刪除預設進入待刪確認，不直接永久刪除</string>
    <string name="onboarding_previous">上一步</string>
    <string name="onboarding_next">下一步</string>
    <string name="onboarding_start">開始使用</string>
