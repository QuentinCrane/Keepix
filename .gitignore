!docs/similar_analysis_task_contract.md
!docs/stats_event_contract.md
!docs/database_table_ownership.md
!docs/performance_baseline.md
!docs/baseline_profile_status.md
!docs/startup_trace.md
!docs/media_sync_state.md
!docs/trash_retention_semantics.md
!docs/web_development_experience.md
!docs/AI_HANDOFF.md
!docs/全面审计_功能完善_性能优化实施规划.md
!docs/en/
docs/en/*
!docs/en/*.md
!docs/website/
!docs/website/*.md
!docs/screenshots/*
!docs/screenshots/README.md

# Public website.
!website/
website/*
!website/index.html
!website/privacy.html
!website/terms.html
!website/css/
!website/css/*.css
!website/js/
!website/js/*.js
!website/assets/
website/assets/*
!website/assets/icons.svg
!website/assets/*.png
!website/assets/*.jpg
!website/assets/*.jpeg
!website/assets/*.webp
!website/assets/*.svg
!website/assets/apk/
website/assets/apk/*
!website/assets/apk/*.apk
!website/assets/images/
website/assets/images/*
!website/assets/images/*.png
!website/assets/images/*.jpg
!website/assets/images/*.jpeg
!website/assets/images/*.webp
!website/assets/images/*.svg
!website/assets/images/screenshots/
website/assets/images/screenshots/*
!website/assets/images/screenshots/*.png
!website/assets/images/screenshots/*.jpg
!website/assets/images/screenshots/*.jpeg
