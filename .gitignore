# Whitelist-only repository export.
# Everything is ignored by default; only public open-source project files below
# are allowed into Git.
*

# Keep Git ignore rules and line-ending rules.
!.gitignore
!.gitattributes

# Local-only build notes.
PACKAGING_LOCAL.md

# Public project metadata.
!README.md
!README.zh-CN.md
!LICENSE
!NOTICE
!CONTRIBUTING.md
!SECURITY.md

# Gradle project files.
!settings.gradle.kts
!build.gradle.kts
!gradle.properties
!gradlew
!gradlew.bat
!local.properties.example

# Android app module.
!app/
app/*
!app/proguard-rules.pro
!app/build.gradle.kts
!app/src/
!app/src/**
!app/schemas/
!app/schemas/**

# Android benchmark test module.
!benchmark/
!benchmark/build.gradle.kts
!benchmark/README.md
!benchmark/src/
!benchmark/src/**

# Gradle wrapper.
!gradle/
gradle/*
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# GitHub repository configuration.
!.github/
!.github/**

# Public documentation only.
!docs/
docs/*
!docs/architecture.md
!docs/build.md
!docs/github_publishing.md
!docs/privacy.md
!docs/release_notes.md
!docs/technical_overview.md
!docs/settings_truth_table.md
!docs/photo_clean_modes.md
!docs/cleanup_session_targets.md
!docs/cleanup_action_contract.md
